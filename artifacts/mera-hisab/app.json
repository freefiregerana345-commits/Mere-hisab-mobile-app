{
  "expo": {
    "name": "Mera Hisab",
    "slug": "mera-hisab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mera-hisab-icon.png",
    "scheme": "mera-hisab",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/mera-hisab-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F9FF"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.merahisab.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/mera-hisab-icon.png",
        "backgroundColor": "#F6F9FF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "userInterfaceStyle": "light",
      "statusBar": {
        "backgroundColor": "#F6F9FF",
        "barStyle": "dark-content"
      },
      "navigationBar": {
        "backgroundColor": "#F6F9FF",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "favicon": "./assets/images/mera-hisab-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
